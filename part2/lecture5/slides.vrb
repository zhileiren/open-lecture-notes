\frametitle{Map/Filter/Reduce}
\begin{verbatim}

map(lambda x: x ** 2, range(10)
list(map(lambda x: x **2, range(10))

filter(lambda x: x % 2 == 0,
         map(lambda x: x ** 2, range(10)))

reduce(lambda x, y: x + y,
         filter(lambda x: x % 2 == 0,
                  map(lambda x: x ** 2, range(10))))


\end{verbatim}


