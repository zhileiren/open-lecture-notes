\frametitle{JSON}
\scriptsize
\begin{verbatim}
>>> import json
>>> json.loads('["foo", {"bar":["baz", null, 1.0, 2]}]')
['foo', {'bar': ['baz', None, 1.0, 2]}]
>>> from io import StringIO
>>> handle = open('output.json', ``r'')

>>> b = json.load(handle)

>>> print(b)
{'foo': 123, 'bar': 'buz'}
\end{verbatim}
